{
  "threshold": 0,
  "minLines": 8,
  "minTokens": 70,
  "reporters": ["console", "json"],
  "format": ["typescript", "tsx", "javascript", "jsx"],
  "path": ["app", "server", "i18n"],
  "ignore": [
    "**/generated.ts",
    "**/*.stories.*",
    "**/fixtures/**",
    "**/tests/**",
    "**/test/**",
    "**/components/shadcn/**",
    "**/.next/**",
    "**/node_modules/**"
  ]
}
