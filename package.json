{
  "name": "easystore-web",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend project of EasyStore, the web application that empowers you to build your own e-commerce platform without any programming knowledge. This user-friendly solution provides all the tools you need to create, manage, and grow your online store with ease.",
  "author": "EasyStore Team",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "storybook": "storybook dev -p 6006",
    "gql": "env-cmd -f .env graphql-codegen --config codegen.ts",
    "prod": "env-cmd -f .env next build && next start",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:changed": "node tools/lint-changed.mjs",
    "lint:changed:fix": "node tools/lint-changed.mjs --fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run test-errors:test && npm run test:storybook",
    "architecture": "node tools/architecture/check.mjs && npm run architecture:test && npm run architecture:semgrep",
    "architecture:test": "node --test tools/architecture/check.test.mjs",
    "architecture:semgrep": "node tools/semgrep/run.mjs scan --config .semgrep.yml --error app/[locale]/components",
    "duplication": "jscpd --config .jscpd.json",
    "verify": "npm run build && npm run lint:changed:fix && npm run test && npm run architecture && npm run duplication",
    "format:fix": "prettier --write .",
    "docker": "docker-compose up",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "build-storybook": "storybook build",
    "test:storybook": "node tools/test-storybook-changed.mjs",
    "test:storybook:ci": "vitest run --project storybook",
    "install:semgrep": "node tools/semgrep/install-semgrep.mjs",
    "postinstall": "node tools/postinstall.mjs",
    "prepare": "node -e \"if(process.env.NODE_ENV==='development' && !process.env.CI){require('child_process').execFileSync(process.execPath,['node_modules/husky/lib/bin.js','install'],{stdio:'inherit'})}\"",
    "test-errors": "tsx server/errors/tests/test-error-handlers.ts",
    "test-errors:test": "tsx server/errors/tests/test-error-handlers.ts --test",
    "test-errors:conflicts": "tsx server/errors/tests/test-error-handlers.ts --conflicts",
    "test-errors:distribution": "tsx server/errors/tests/test-error-handlers.ts --distribution",
    "test-errors:interactive": "tsx server/errors/tests/test-error-handlers.ts --interactive"
  },
  "dependencies": {
    "@apollo/client": "4.0.4",
    "@apollo/client-integration-nextjs": "0.14.5",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@imagekit/next": "2.1.2",
    "@lottiefiles/dotlottie-react": "0.14.1",
    "@radix-ui/react-accordion": "1.2.10",
    "@radix-ui/react-alert-dialog": "1.1.14",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.7",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-toggle": "1.1.9",
    "@radix-ui/react-toggle-group": "1.1.10",
    "@radix-ui/react-tooltip": "1.2.7",
    "@tabler/icons-react": "3.34.1",
    "@tanstack/react-table": "8.21.3",
    "babel-plugin-react-compiler": "19.0.0-beta-aeaed83-20250323",
    "chrono-node": "2.9.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "date-fns": "4.1.0",
    "decimal.js": "10.6.0",
    "embla-carousel-react": "8.6.0",
    "graphql": "16.11.0",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "next-intl": "4.13.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-day-picker": "9.11.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-icons": "5.5.0",
    "recharts": "2.15.4",
    "sonner": "2.0.5",
    "swr": "2.3.6",
    "tw-animate-css": "1.2.8",
    "vaul": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3",
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/client-preset": "4.8.3",
    "@graphql-codegen/typed-document-node": "6.0.0",
    "@graphql-codegen/typescript": "5.0.0",
    "@graphql-codegen/typescript-operations": "5.0.0",
    "@graphql-eslint/eslint-plugin": "4.4.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@shadcn/lint": "0.2.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "4",
    "@types/graphql": "14.2.3",
    "@types/node": "24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.70.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "16.6.1",
    "env-cmd": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.2.5",
    "eslint-plugin-security": "4.1.0",
    "eslint-plugin-storybook": "10.6.1",
    "husky": "8.0.0",
    "jscpd": "4.0.5",
    "lint-staged": "15.5.0",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.63.0",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "shadcn": "4.21.4",
    "storybook": "10.6.1",
    "tailwindcss": "4",
    "tsx": "4.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
